# ============================================
# CONFIGURACIÓN EXPORT‑VIEWER‑SERVICE - EJEMPLO
# ============================================

# URLs de los servicios downstream (incluye esquema y puerto)
EXTRACTOR_URL=http://pdf-extractor-service:8000
CRUD_URL=http://document-crud-service:8000

# Timeout (segundos) para llamadas HTTP a downstream
HTTP_TIMEOUT=5

# Nivel de logging (debug, info, warning, error)
LOGLEVEL=info

# Máximo número de reintentos en llamadas a downstream
RETRY_ATTEMPTS=3

# Recursos de Docker (informativo)
CPU_LIMIT=1
MEMORY_LIMIT=512m

