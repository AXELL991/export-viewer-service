# ============================================
# CONFIGURACIÓN EXPORT-VIEWER-SERVICE - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.
# Generar el token interno con: openssl rand -hex 32

# --- URLs de los servicios downstream (incluye esquema y puerto) ---
# Nombres de servicio que coinciden con el docker-compose interno.
EXTRACTOR_URL=http://pdf-extractor-service:8000
CRUD_URL=http://document-crud-service:8000

# --- Timeouts separados (segundos) ---
# Tiempo máximo para establecer la conexión TCP.
CONNECT_TIMEOUT=5
# Tiempo de lectura para llamadas al extractor (ej. 60 s).
EXTRACTOR_READ_TIMEOUT=60
# Tiempo de lectura para llamadas al CRUD (ej. 5 s).
CRUD_READ_TIMEOUT=5

# --- Reintentos con backoff exponencial y jitter ---
RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=0.5

# --- Circuit breaker por downstream ---
# Fallos consecutivos para abrir el circuito.
CIRCUIT_BREAKER_FAILURES=5
# Segundos que permanece abierto el circuito antes de medio-abrirlo.
CIRCUIT_BREAKER_RECOVERY=30

# --- Rate limit por IP (memoria, por proceso) ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
# Confía en X-Forwarded-For solo si el orquestador está detrás de proxy de confianza.
TRUSTED_PROXY=false

# --- Límites ---
# Tamaño máximo de PDF en megabytes (se aplica también en el extractor).
MAX_FILE_SIZE_MB=10

# --- Logging ---
# Nivel de logging: debug, info, warning, error
LOGLEVEL=info

# --- Auth interna ---
# Token que envía el orquestador a los downstream en X-Internal-Token.
# El mismo valor debe configurarse en extractor y CRUD.
# Generar con: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me

# --- Puerto público (documentado para compose) ---
PUBLIC_PORT=8000

# --- Credenciales de MongoDB (usadas por document-crud-service y compose) ---
# En producción crear un usuario limitado a document_crud_db.
MONGO_ROOT_USER=mongouser
MONGO_ROOT_PASS=mongopassword
