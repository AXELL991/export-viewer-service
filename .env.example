# ============================================
# CONFIGURACIÓN export-viewer-service - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.
# Generar el token interno con: openssl rand -hex 32

# --- URLs de los servicios downstream (nombres de servicio Docker) ---
EXTRACTOR_URL=http://pdf-extractor-service:8000
CRUD_URL=http://document-crud-service:8000

# --- Timeouts separados (segundos) ---
CONNECT_TIMEOUT=5
EXTRACTOR_READ_TIMEOUT=60
CRUD_READ_TIMEOUT=5

# --- Reintentos con backoff exponencial y jitter ---
RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=0.5

# --- Circuit breaker por downstream ---
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RECOVERY=30

# --- Rate limit por IP (Redis o memoria) ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
TRUSTED_PROXY=false

# --- Límites ---
MAX_FILE_SIZE_MB=10

# --- Logging ---
LOGLEVEL=info

# --- Auth interna (coincidir con extractor y CRUD) ---
INTERNAL_API_TOKEN=change-me-in-production

# --- Puerto público ---
PUBLIC_PORT=8000

# --- Redis para rate limiting compartido ---
REDIS_URL=redis://redis:6379/0