# ============================================
# CONFIGURACIÓN export-viewer-service
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.
# Generar el token interno con: openssl rand -hex 32

# --- URLs de los servicios downstream (incluye esquema y puerto) ---
EXTRACTOR_URL=http://pdf-extractor-service:8000
CRUD_URL=http://document-crud-service:8000

# --- Timeouts separados (segundos) ---
CONNECT_TIMEOUT=5
EXTRACTOR_READ_TIMEOUT=60
CRUD_READ_TIMEOUT=5

# --- Reintentos con backoff exponencial y jitter ---
RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=0.5

# --- Límites ---
MAX_FILE_SIZE_MB=15

# --- Logging ---
LOGLEVEL=info

# --- Auth interna ---
# Generar con: openssl rand -hex 32
INTERNAL_API_TOKEN=tu_token_aqui_cambialo_en_produccion

# --- Puerto público ---
PUBLIC_PORT=8000

# --- MongoDB auth ---
MONGO_ROOT_USERNAME=pdf_admin
MONGO_ROOT_PASSWORD=cambia_esta_contraseña_en_produccion

# --- Redis auth ---
REDIS_PASSWORD=cambia_esta_contraseña_en_produccion
